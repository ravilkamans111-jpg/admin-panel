# Local development only. Copy to .env and adjust as needed.
# In any deployed environment, USE_LOCAL_ENV_SECRETS must be false/unset and
# VAULT_ADDR/VAULT_TOKEN (or VAULT_ROLE_ID/VAULT_SECRET_ID) must point at a
# real Vault — see app/core/vault.py and app/core/config.py.

USE_LOCAL_ENV_SECRETS=true

CONTROL_PLANE_DATABASE_URL=postgresql+asyncpg://admin_panel:admin_panel@localhost:5442/admin_panel_control

JWT_SECRET_KEY=dev-only-change-me-1234567890abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Single hardcoded superuser — checked in-code before ever touching the
# control-plane DB (app.services.auth_service.HARDCODED_SUPERUSER_ID).
# MUST be overridden with real values before any deployed environment goes
# live; these defaults are public (they're in this repo).
HARDCODED_SUPERUSER_EMAIL=admin@example.com
HARDCODED_SUPERUSER_PASSWORD=SuperSecret123!

BRAND_AMPAY_DB_HOST=localhost
BRAND_AMPAY_DB_PORT=5443
BRAND_AMPAY_DB_NAME=ampay
BRAND_AMPAY_DB_USER=ampay
BRAND_AMPAY_DB_PASSWORD=ampay

BRAND_RAJAPAY_DB_HOST=localhost
BRAND_RAJAPAY_DB_PORT=5444
BRAND_RAJAPAY_DB_NAME=rajapay
BRAND_RAJAPAY_DB_USER=rajapay
BRAND_RAJAPAY_DB_PASSWORD=rajapay

BRAND_QUIET_FOREST_DB_HOST=localhost
BRAND_QUIET_FOREST_DB_PORT=5445
BRAND_QUIET_FOREST_DB_NAME=quiet_forest
BRAND_QUIET_FOREST_DB_USER=quiet_forest
BRAND_QUIET_FOREST_DB_PASSWORD=quiet_forest

# One local Redis (docker compose up -d redis), one logical DB index per
# brand so invalidation on one brand never touches another's keys.
BRAND_AMPAY_REDIS_URL=redis://localhost:6379/0
BRAND_RAJAPAY_REDIS_URL=redis://localhost:6379/1
BRAND_QUIET_FOREST_REDIS_URL=redis://localhost:6379/2

# Same local Redis, used as a Celery broker (separate db indices) so
# app.db.tenant_celery.send_task has somewhere to enqueue onto — in a real
# deployment this points at the monolith's actual Celery broker instead, so
# ITS workers execute the enqueued task (see app.services.callback_service).
BRAND_AMPAY_CELERY_BROKER_URL=redis://localhost:6379/4
BRAND_RAJAPAY_CELERY_BROKER_URL=redis://localhost:6379/5
BRAND_QUIET_FOREST_CELERY_BROKER_URL=redis://localhost:6379/6

# Optional — only needed for the "Отправить коллбэки выбранным пользователям
# в телеграмм" settlements action (app.services.callback_service). Unset =
# that action fails per-call with a clear error, not at startup.
# BRAND_AMPAY_BOT_CALLBACK_URL=

CORS_ALLOW_ORIGINS=http://localhost:3000
