# Copy to `.env` next to docker-compose.prod.yml and fill in every value.
# Brand databases, Redis, Celery, the JWT key and the rest are NOT here: they are read
# from Vault (see DEPLOY.md for the exact keys).

# --- Frontend build ---------------------------------------------------------------
# Public URL of the API as the browser reaches it (through your reverse proxy), no trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://api.admin.example.com

# --- Backend ------------------------------------------------------------------------
# Public URL(s) of the UI, comma-separated — the only browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=https://admin.example.com

# Vault — the same variables the monoliths use (core/vault_loader.py).
VAULT_ADDR=https://vault.example.com
VAULT_USERNAME=
VAULT_PASSWORD=
VAULT_MOUNT=backend
# Only if a brand keeps its secrets in its own mount (uncomment per brand):
# VAULT_MOUNT_AMPAY=
# VAULT_MOUNT_RAJAPAY=
# VAULT_MOUNT_QUIET_FOREST=

# Login throttling (defaults shown): failed attempts before a login name is locked, and for how long.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
